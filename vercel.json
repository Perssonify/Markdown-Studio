{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "web": {
      "root": "apps/web",
      "framework": "vite",
      "installCommand": "bun install --frozen-lockfile",
      "buildCommand": "bun run build:app:accounts && node scripts/strip-sourcemaps.mjs",
      "devCommand": "bun run dev --port $PORT",
      "outputDirectory": "dist-app",
      "rewrites": [
        {
          "source": "/((?!api/|assets/|\\.well-known/|embed\\.html).*)",
          "destination": "/index.html"
        }
      ],
      "headers": [
        {
          "source": "/((?!api/|embed\\.html).*)",
          "headers": [
            {
              "key": "Content-Security-Policy-Report-Only",
              "value": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval' 'sha256-hq3Xx1aiQlCCt70h5Eyvba4ZbPwxhT3wZDtmv9Fhvtw=' 'sha256-PPIs1fo1NJLYNkRghaKz3J8g0CmPWa1rbMx0XvIPb+Q=' 'sha256-dRXd3igj4oEw401JvMJ3lfR8r8Z6ZJUSnPZNH5bbfPw=' 'sha256-ZdfEy6xR57DrwDYRVRcVXtYHOLJrHYok+33CZR8fWUE='; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; media-src 'self' data: blob: https:; font-src 'self' data:; connect-src 'self' https: data: blob:; worker-src 'self' blob: data:; frame-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
            },
            {
              "key": "Content-Security-Policy",
              "value": "frame-ancestors 'none'"
            },
            {
              "key": "X-Frame-Options",
              "value": "DENY"
            }
          ]
        },
        {
          "source": "/embed.html",
          "headers": [
            {
              "key": "Content-Security-Policy-Report-Only",
              "value": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval' 'sha256-hq3Xx1aiQlCCt70h5Eyvba4ZbPwxhT3wZDtmv9Fhvtw=' 'sha256-PPIs1fo1NJLYNkRghaKz3J8g0CmPWa1rbMx0XvIPb+Q=' 'sha256-dRXd3igj4oEw401JvMJ3lfR8r8Z6ZJUSnPZNH5bbfPw=' 'sha256-ZdfEy6xR57DrwDYRVRcVXtYHOLJrHYok+33CZR8fWUE='; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; media-src 'self' data: blob: https:; font-src 'self' data:; connect-src 'self' https: data: blob:; worker-src 'self' blob: data:; frame-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'"
            }
          ]
        },
        {
          "source": "/assets/(.*)",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=31536000, immutable"
            }
          ]
        },
        {
          "source": "/sw.js",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache, no-store, must-revalidate"
            }
          ]
        },
        {
          "source": "/sw-recover.js",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache, no-store, must-revalidate"
            }
          ]
        },
        {
          "source": "/manifest.webmanifest",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache, must-revalidate"
            }
          ]
        },
        {
          "source": "/index.html",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache, must-revalidate"
            }
          ]
        }
      ]
    },
    "api": {
      "root": "apps/api",
      "framework": "hono",
      "installCommand": "bun install --frozen-lockfile",
      "buildCommand": "bun run build:vercel",
      "outputDirectory": "dist/vercel",
      "entrypoint": "src/vercel.ts",
      "functions": {
        "src/vercel.ts": {
          "maxDuration": 25
        }
      }
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "web"
      }
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=(), serial=(), hid=(), midi=(), display-capture=(), magnetometer=(), gyroscope=(), accelerometer=()"
        }
      ]
    }
  ]
}
