{
  "name": "@perssonify/editor",
  "version": "1.77.0",
  "description": "Markdown Studio — a private, offline-capable dual-pane Markdown editor for focused writing and serious Markdown.",
  "keywords": [
    "markdown",
    "markdown-editor",
    "wysiwyg",
    "rich-text",
    "dual-pane",
    "editor",
    "codemirror",
    "codemirror-6",
    "tiptap",
    "prosemirror",
    "react",
    "react-component",
    "offline-first",
    "wiki-links"
  ],
  "author": "Perssonify Labs (https://perssonify.com)",
  "homepage": "https://markdownstudio.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SolutionPath/markdown-studio.git"
  },
  "bugs": {
    "url": "https://github.com/SolutionPath/markdown-studio/issues"
  },
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./engine": {
      "types": "./dist/engine/useMarkdownEngine.d.ts",
      "import": "./dist/engine.js",
      "require": "./dist/engine.cjs"
    },
    "./store": {
      "types": "./dist/store/index.d.ts",
      "import": "./dist/store.js",
      "require": "./dist/store.cjs"
    },
    "./integration": {
      "types": "./dist/integration/index.d.ts",
      "import": "./dist/integration.js",
      "require": "./dist/integration.cjs"
    },
    "./styles.css": "./dist/styles.css"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "vite --config vite.app.config.ts",
    "build": "vite build && tsc -p tsconfig.build.json",
    "build:app": "vite build --config vite.app.config.ts",
    "build:embed": "vite build --config vite.embed.config.ts",
    "preview": "vite preview --config vite.app.config.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "build:types": "tsc -p tsconfig.build.json",
    "e2e": "node e2e/run.mjs",
    "e2e:smoke": "node e2e/run.mjs surfaces",
    "e2e:deep": "node e2e/run.mjs surfaces-deep",
    "e2e:dataloss": "node e2e/run.mjs dataloss",
    "e2e:harness": "node e2e/run.mjs harness",
    "e2e:stress": "node e2e/run.mjs stress",
    "e2e:journeys": "node e2e/run.mjs journeys",
    "e2e:faults": "node e2e/run.mjs faults",
    "e2e:library": "node e2e/run.mjs library",
    "e2e:bridge": "node e2e/run.mjs bridge",
    "e2e:perf": "node e2e/run.mjs perf"
  },
  "peerDependencies": {
    "@codemirror/commands": ">=6",
    "@codemirror/lang-markdown": ">=6",
    "@codemirror/language": ">=6",
    "@codemirror/search": ">=6",
    "@codemirror/state": ">=6",
    "@codemirror/view": ">=6",
    "@lezer/highlight": ">=1",
    "@tiptap/core": ">=3",
    "@tiptap/extension-color": ">=3",
    "@tiptap/extension-font-family": ">=3",
    "@tiptap/extension-highlight": ">=3",
    "@tiptap/extension-image": ">=3",
    "@tiptap/extension-link": ">=3",
    "@tiptap/extension-placeholder": ">=3",
    "@tiptap/extension-subscript": ">=3",
    "@tiptap/extension-superscript": ">=3",
    "@tiptap/extension-table": ">=3",
    "@tiptap/extension-table-cell": ">=3",
    "@tiptap/extension-table-header": ">=3",
    "@tiptap/extension-table-row": ">=3",
    "@tiptap/extension-text-align": ">=3",
    "@tiptap/extension-text-style": ">=3",
    "@tiptap/extension-underline": ">=3",
    "@tiptap/pm": ">=3",
    "@tiptap/react": ">=3",
    "@tiptap/starter-kit": ">=3",
    "lucide-react": ">=0.400.0",
    "next-themes": ">=0.4.0",
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0",
    "zustand": ">=5.0.0"
  },
  "devDependencies": {
    "@codemirror/commands": "^6.10.2",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/language": "^6.12.1",
    "@codemirror/search": "^6.6.0",
    "@codemirror/state": "^6.5.4",
    "@codemirror/view": "^6.39.14",
    "@fontsource-variable/geist": ">=5",
    "@fontsource-variable/inter": ">=5",
    "@lezer/highlight": "^1.2.3",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@tiptap/core": "3.20.0",
    "@tiptap/extension-color": "3.20.0",
