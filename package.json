{
  "name": "markdown-studio",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*",
    "infra"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build build:app build:embed",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:generate": "bun run --cwd packages/db generate",
    "db:migrate": "bun run --cwd packages/db migrate",
    "deploy": "bun run --cwd infra deploy",
    "deploy:web": "bun run --cwd infra deploy -- --web-only"
  },
  "devDependencies": {
    "turbo": "2.11.7"
  },
  "overrides": {
    "vite": "8.1.5",
    "rollup": "4.62.2",
    "postcss": "8.5.23",
    "picomatch": "4.0.5",
    "katex": "^0.18.1",
    "lodash-es": "^4.18.1"
  },
  "packageManager": "bun@1.4.0",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  }
}
