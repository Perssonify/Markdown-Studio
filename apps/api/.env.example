# Copy to apps/api/.env (git-ignored). Every value is optional for local work:
# without a database the API runs and /health reports db: "not_configured".

PORT=4000
# The frontend's dev and preview servers.
CORS_ORIGINS=http://localhost:5173,http://localhost:4173
# Where the browser reaches the API: the EDITOR's address, because the dev server
# forwards /api to this process (Better Auth builds callback URLs from it).
PUBLIC_URL=http://localhost:5173

# `bun run db:up` starts this Postgres in Docker (docker-compose.yml);
# `bun run db:migrate` creates the tables.
DATABASE_URL=postgres://markdown_studio:markdown_studio@localhost:5440/markdown_studio
DATABASE_SSL=off
# Test suites create their own throwaway databases on this server.
TEST_DATABASE_URL=postgres://markdown_studio:markdown_studio@localhost:5440/markdown_studio

# Google sign-in. Off until all three are set.
# BETTER_AUTH_SECRET: any random string of 32+ characters (openssl rand -base64 32).
# The Google OAuth client must allow http://localhost:5173/api/auth/callback/google.
BETTER_AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# File storage (S3). `bun run db:up` also starts a local S3-compatible server
# (docker-compose.yml) with this bucket; the keys are throwaway, local only.
# On AWS the bucket comes from infra and access from the Lambda's role.
S3_BUCKET=markdown-studio-local
S3_ENDPOINT=http://localhost:9540
S3_FORCE_PATH_STYLE=true
S3_ACCESS_KEY_ID=local
S3_SECRET_ACCESS_KEY=local
# Test suites create their own throwaway buckets on this server.
TEST_S3_ENDPOINT=http://localhost:9540
