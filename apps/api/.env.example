# Copy to apps/api/.env (git-ignored). Every value is optional for local work:
# without a database the API runs and /health reports db: "not_configured".

PORT=4000
# The frontend's dev and preview servers.
CORS_ORIGINS=http://localhost:5173,http://localhost:4173
# Where the browser reaches the API (Better Auth builds callback URLs from it).
PUBLIC_URL=http://localhost:4000

# `bun run db:up` starts this Postgres in Docker (docker-compose.yml);
# `bun run db:migrate` creates the tables.
DATABASE_URL=postgres://markdown_studio:markdown_studio@localhost:5440/markdown_studio
DATABASE_SSL=off
# Test suites create their own throwaway databases on this server.
TEST_DATABASE_URL=postgres://markdown_studio:markdown_studio@localhost:5440/markdown_studio

# Google sign-in. Off until all three are set.
# BETTER_AUTH_SECRET: any random string of 32+ characters (openssl rand -base64 32).
# The Google OAuth client must allow http://localhost:4000/api/auth/callback/google.
BETTER_AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
