{
  // Declaration-only build for the published library.
  //
  // The root tsconfig is the type GATE (noEmit) used by `bunx tsc --noEmit` and
  // CI. This variant emits ONLY .d.ts into dist/ so `@perssonify/editor` ships
  // types — without it, TypeScript consumers (e.g. a Three.js host app) get an
  // implicit-any module and no editor intellisense.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "emitDeclarationOnly": true,
    // No declaration maps: they point back into src/, which is not published,
    // so a consumer's "go to definition" would only find a dangling reference.
    "declarationMap": false,
    "outDir": "dist",
    // Explicit since TypeScript 6, whose default is the tsconfig's own directory:
    // the package exports map expects dist/index.d.ts, not dist/src/index.d.ts.
    "rootDir": "./src",
    // Declaration emit must not fail on the app-only surface or on generated
    // primitives; the real type gate still covers those.
    "skipLibCheck": true
  },
  "include": [
    "src/index.tsx",
    "src/engine/useMarkdownEngine.ts",
    "src/store/index.ts",
    "src/integration/index.ts",
    "src/**/*.ts",
    "src/**/*.tsx"
  ],
  "exclude": ["src/__tests__/**", "src/main.tsx", "src/embed.tsx"]
}
