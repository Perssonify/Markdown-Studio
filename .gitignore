# Monorepo-level ignores. Each app keeps its own .gitignore for its outputs
# (apps/web/.gitignore is the frontend's, moved in unchanged).
node_modules/
.turbo/
coverage/
# Build output of every package (the API bundle, …); apps/web/.gitignore
# lists the editor's own.
dist/
.DS_Store
*.tsbuildinfo

# Local secrets. Every app ships a .env.example; the real files never leave
# the machine.
.env
.env.*
!.env.example

# Vercel: the linked project (`vercel link`) and `vercel build` output. The
# project is the repository root — vercel.json's services.
.vercel/

# AWS CDK output. cdk.context.json caches lookups keyed by the AWS account
# ID, so it stays on the machine that deploys.
infra/cdk.out/
infra/cdk.context.json
infra/cdk.context.local.json

# Local tooling state (never part of the project).
.claude/worktrees/
.claude/scheduled_tasks.lock
.vscode/
